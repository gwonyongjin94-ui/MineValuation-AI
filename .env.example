SEC_USER_AGENT="SafetyMargin-AI you@example.com"

# Optional - only needed for V2 qualitative risk extraction
# (app/qualitative/). Get one at console.anthropic.com.
ANTHROPIC_API_KEY=

# Optional - only needed when deploying the API for the docs/ GitHub
# Pages frontend to call cross-origin. Comma-separated, e.g.
# "https://<your-github-username>.github.io". Leave empty for local-only
# use (the CLI/docs curl examples don't need this - only a browser
# fetch() from a different origin does).
ALLOWED_ORIGINS=
