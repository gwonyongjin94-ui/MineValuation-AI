{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "safetymargin-ai",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": ["app.main:app", "--reload", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8080", "--directory", "site"],
      "port": 8080
    }
  ]
}
